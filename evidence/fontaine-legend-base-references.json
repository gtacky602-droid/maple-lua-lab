  "encounters": [
    {
      "id": "legend-fontaine_vivianne_of_the_lake",
      "name": "湖辺のヴィヴィアン",
      "ordinary_enemy": "濁水噴出の幻霊",
      "reuse": "shared_waiting_art",
      "references": [
        "water-duo",
        "spouting",
        "vivianne",
        "vivianne-side"
      ],
      "visual_observation": "小さな水塊が胴より上に浮く。そこに青白い片目があり、両腕が胴の左右から反り上がる。胴は下が細く、端がしずくになる。",
      "art_direction": "通常の噴出型に第5稿Aの待機絵を共用する。頭の泡、周りの光、放水時の光輪は片目と区別する。",
      "unchecked": "真横・背面の図鑑モデル、光の差が状態で切り替わる条件。"
    },
    {
      "id": "legend-fontaine_ninianne_of_the_lake",
      "name": "湖辺のニニアン",
      "ordinary_enemy": "濁水粉砕の幻霊",
      "reuse": "shared_waiting_art",
      "references": [
        "water-duo",
        "splitting",
        "ninianne",
        "ninianne-close"
      ],
      "visual_observation": "左右の太い腕の間に丸みのある顔があり、濃い青紫の縁に青白い片目が浮く。腕を上げても顔の位置は胴の中央。",
      "art_direction": "通常の粉砕型に第5稿Aの待機絵を共用する。顔と浮く泡を離し、噴出型との胴・腕の違いを残す。",
      "unchecked": "背面の水の模様、通常型との全ポーズの一致。"
    },
    {
      "id": "legend-fontaine_automated_supercomputing_field_generator",
      "name": "自律スーパー・コンピューティング型力場生成装置",
      "ordinary_enemy": "マシナリー・演算力増幅器",
      "reuse": "shared_body_with_effect",
      "references": [
        "mek-codex",
        "mek-field",
        "aur-field",
        "aur-alt"
      ],
      "visual_observation": "頭部の穴のある金具、横に持ち上がる外装、中央の段差と細い脚が共通。名前付きの画面では黄色い球状の力場と周囲の浮遊物が本体を覆う。",
      "art_direction": "演算力増幅器と本体の輪郭を共用する。黄色の力場と浮遊物は別レイヤー。既存の通常ボス「実験用フィールド生成装置」の本体は別種。",
      "unchecked": "背面の外装と、プネウマ・ウーシア別の点灯色。"
    },
    {
      "id": "legend-fontaine_iron_viscount",
      "name": "鉄皮の子爵",
      "ordinary_enemy": "堅盾重甲ヤドカニ",
      "reuse": "shared_body_review_palette",
      "references": [
        "sternshield",
        "crab-base",
        "viscount",
        "viscount-alt"
      ],
      "visual_observation": "小型の重甲ヤドカニは橙の丸い殻。堅盾型と鉄皮の子爵は何段も張り出す殻と左右で形の違う一対の前脚を持つ。子爵の殻は洞窟画像では赤紫寄りに見える。",
      "art_direction": "堅盾型の殻の段差、脚の節、前脚の非対称を共用する。地形の橙光と水中の反射を除いた色は暫定。",
      "unchecked": "通常の堅盾型の背面と水中側面、色を同条件で比較した場合の固有差。"
    },
    {
      "id": "legend-fontaine_ocean_circuit_judge",
      "name": "オーシャン巡回法官",
      "ordinary_enemy": "堅盾重甲ヤドカニ",
      "reuse": "shared_body_review_palette",
      "references": [
        "sternshield",
        "crab-base",
        "judge",
        "judge-alt"
      ],
      "visual_observation": "段になった殻、淡い節と濃い丸い前脚の左右差が堅盾型と共通。現地2枚では殻は青紫寄りに見え、濃色の前脚に黄のくぼみが読める。",
      "art_direction": "堅盾型の輪郭を共用する。画面で見える青紫と黄色のくぼみは候補に残し、水中の照明による色差を確認する。",
      "unchecked": "同じ照明で子爵・通常個体と並べたときの殻の色。"
    },
    {
      "id": "legend-fontaine_fairy_knight_twins",
      "name": "双生妖精の騎士",
      "ordinary_enemy": "狩猟刀エイ",
      "reuse": "shared_body_review_palette",
      "references": [
        "ray-base",
        "twins"
      ],
      "visual_observation": "普通の黄緑の図鑑画像と名付きの水中画面に、平たい胴、幅広く先が尖るひれ、細い尾が見える。名付きのひれは桃紫寄り。",
      "art_direction": "狩猟刀エイの胴とひれを共用する。桃紫は通常種の黄緑から一律置換する根拠にせず、名付きの個体色の資料として扱う。",
      "unchecked": "アンジェリカ・ミドロと色の個別対応、通常種の各色の全身正面。"
    },
    {
      "id": "legend-fontaine_swords_of_the_gorge",
      "name": "深谷の剣",
      "ordinary_enemy": "狩猟刀エイ",
      "reuse": "shared_body_review_palette",
      "references": [
        "ray-base",
        "gorge"
      ],
      "visual_observation": "二体にひれの広い輪郭と細い尾が見える。通常種にも同じひれの前後関係がある。名付きは手前のひれが桃寄り、奥側は青紫に見える。",
      "art_direction": "体とひれの形は通常種と共用し、二体の配色は名前と同時に確認できる資料が増えてから決める。",
      "unchecked": "コルタナ・モーグレイと色の個別対応、背景光をそろえた比較。"
    },
    {
      "id": "legend-fontaine_fading_veteran",
      "name": "消えゆく老兵",
      "ordinary_enemy": "プクプク獣",
      "reuse": "shared_body_review_palette",
      "references": [
        "seal-base",
        "seal-shapes",
        "veteran"
      ],
      "visual_observation": "丸い胴の下側に明るい面があり、左右の前ひれと尾が出る。一般種の正面像と名前付きの遊泳中に共通する。",
      "art_direction": "プクプク獣の体格を共用し、遊泳や透明化の状態を別に描く。ひれの向きは公式の亜種図も参照する。",
      "unchecked": "背中の模様、通常の個体と同じ照明での色差。"
    },
    {
      "id": "legend-fontaine_dobharcu_lord_of_the_hidden",
      "name": "隠者の王ドアーチュ",
      "ordinary_enemy": "プクプク獣",
      "reuse": "shared_body_review_palette",
      "references": [
        "seal-base",
        "seal-shapes",
        "king"
      ],
      "visual_observation": "通常の図鑑画像と丸い口元、広い腹、短く広がる前ひれが共通。水中の名前付き画像では腹のほうが明るい。",
      "art_direction": "プクプク獣の体格を共用する。明るい腹と前ひれを残して色、模様の固有差を追加資料で確かめる。",
      "unchecked": "背面の模様、近距離での待機時の色。"
    }
  ]
}
