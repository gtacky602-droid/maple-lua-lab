  "themes": {
    "region-01": [
      "スライム、ヒルチャール、射手・シャーマン",
      "湖畔と城門は弱い群れ、遺跡の守衛や奔狼領の獣域は任意脇道。アンバー初回依頼の敵ID・必要数は保持。"
    ],
    "region-02": [
      "スライム、ヒルチャール、宝盗団",
      "街道・港の周囲と岩場を分ける。ヴィシャップや遺跡機械は広い側道。沈玉4地点を低Lv璃月から分離。"
    ],
    "region-03": [
      "野伏衆・海乱鬼、スライム、フライム",
      "鳴神島の灯籠メインと他島の強敵を分離。ヤシオリの聖骸獣、鶴観の獣域は任意寄り道。狸と訓練的は討伐対象外。"
    ],
    "region-04": [
      "キノコン、エルマイト旅団、ヒルチャール",
      "雨林の群れと砂漠の軍営・構造体を分ける。上層観測所や作業足場に通常狩場の群れを重ねない。"
    ],
    "region-05": [
      "陸上マシナリー、宝盗団、スライム",
      "サラシア・タラッタの水中狩場では巡回機と交戦できる。観察・通行区画は敵0。水中の地方伝説は入口から任意で挑戦できる。"
    ],
    "region-06": [
      "部族竜戦士、地域に合う竜、スライム",
      "こだま・懸木・南岸・夜風・北西・アトクパンで兵種/竜種を選ぶ。友好竜と幼竜を除外。旗取りの2ルートとカチーナ演出を保持。"
    ],
    "region-07": [
      "特務隊、陸巡艇、スライム、宝盗団",
      "軍事道と海岸、森を分ける。継霊者・集光の異獣・ワイルドハント・闇の漁師は低密度。創作章ボスとカニ皇帝は別遭遇。"
    ],
    "region-08": [
      "異種合成獣、晶石肌のフェイ、特務隊",
      "氷スライムだけで埋めず、新地域の生態を主役にする。異怪・木の精・凝氷体は精鋭側。列車と雪国章の既存敵は保持。"
    ],
    "branch-01": [
      "氷系スライム、ヒルチャール、ファデュイ",
      "雪山の守衛・重機・霜鎧の王を脇道へ。フィンドニールをLv55へ修正。撮影クエストの岩殻虫と独自ボスは維持。"
    ],
    "branch-02": [
      "宝盗団、ヒルチャール、スライム",
      "玄文獣は山道の少数精鋭。茶亭や荷運びの休憩場所は安全。赤璋巡岳府君はLv95、2体で1遭遇。"
    ],
    "branch-03": [
      "ヒルチャール、フライム、ヴィシャップ",
      "床と灯りの切替を邪魔しない群れ。遺跡ハンターは単独、ヴィシャップは精鋭。独自の板尾ボスを差し替えない。"
    ],
    "branch-04": [
      "外縁のファデュイ、地下の宝盗団・キノコン",
      "公式の同層分布を優先。遺跡守衛は別室、獣域は任務/宝箱由来の任意一回遭遇。構造体だけの一様な構成にしない。"
    ],
    "branch-05": [
      "原海アベラントの生息、魔像プラエトリアニ",
      "水路は非戦闘。3つの乾いた遺構室へ魔像各2体。シネアスはLv160の別室。水中マシナリー等を通常主力から外す。"
    ],
    "branch-06": [
      "ヒルチャール、スライム、宝盗団",
      "港・復帰点は安全。北モンドの風止み側をLv160へ。チャルデリックLv175と独自港ボスを区別。島への徒歩接続は作らない。"
    ],
    "branch-07": [
      "ユムカ/クク系の竜、ミミック、遺跡機械",
      "古都の段差と機構に合わせた少群れ。銅の錠はLv180。クエストLv180/182/185と既存搬出装置・独自ボスを保護。"
    ],
    "branch-08": [
      "特務隊、陸巡艇、継霊者、ワイルドハント",
      "公式地図未対応の8設計区画。準備点0、スライム24、軍営24、異獣8、陸巡艇16、継霊者等8、狩猟団12、終端任意1。霜月と別地域。"
    ],
    "branch-09": [
      "異種合成獣、特務隊、陸巡艇、凝氷体",
      "地上搬出路と地下鉱区を分離。異怪は少数精鋭。地方伝説2遭遇をLv198/200へ。波濤の投錨者の高難度側はLv200の別配置。"
    ],
    "hidden-01": [
      "風/水スライム、ヒルチャール",
      "過去イベントの出現例を基にした8設計区画。海辺の群れと風の高台、任意の単独精鋭。公式現在座標は作らない。"
    ],
    "hidden-02": [
      "キノコン、外周のヒルチャール",
      "駅・乗降場を敵0にする。園の生き物と敵を区別。トロッコの乗降や既存の舞台ボスの進行を変えない。"
    ],
    "hidden-03": [
      "ヒルチャール、射手、少数レンジャー",
      "王城広場と駅、砕けた海の観察場は安全。友好的な風スライム/キノコンは討伐対象外。折り目の経路を塞がない。"
    ],
    "official-area-6": [
      "ヒルチャール、宝盗団、キノコン、遺跡機兵",
      "層岩地下独立マップ。獣域や黒蛇騎士は少数区画。地下の別階層を同室の根拠に使わない。"
    ],
    "official-area-12": [
      "竜、秘源機兵、ミミック、マグマイタチ",
      "常設マーカーにない部族戦士・スライムを主力にしない。竜の生態域と機構室を分離。微末はLv130の任意試練。"
    ],
    "official-area-14": [
      "領域の番人を中心とする精鋭狩場",
      "3画面の番人12体が基準。キノコンは千柱中央6体、アベラントは砂上の限定区画4体。玄文獣/重機は各1。太子Lv185。"
    ],
    "official-area-15": [
      "コマンダー陣形、継霊者、スライム、花・キノコン",
      "機構施設はコマンダー8体、継霊者の区画は8体。混在域は12〜18体。原作地方伝説2件と創作の霜月の閉門者Lv195を分ける。"
    ]
  }
}
