                  "field_id",
                  "view_id",
                  "x",
                  "y"
                ]
              },
              "additionalProperties": {
                "enum": [
                  "unassigned",
                  "proposed",
                  "approved",
                  "implemented",
                  "verified"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "collection",
            "id"
          ],
          "properties": {
            "collection": {
              "const": "graph_exceptions"
            },
            "id": {
              "type": "string"
            },
            "action": {
              "enum": [
                "upsert",
                "delete"
              ]
            },
            "changes": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "code": {
                  "enum": [
                    "unreachable",
                    "dead_end",
                    "no_return",
                    "level_jump",
                    "quest_route"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "states": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "code",
                  "reason",
                  "target_id"
                ]
              },
              "additionalProperties": {
                "enum": [
                  "unassigned",
                  "proposed",
                  "approved",
                  "implemented",
                  "verified"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "proposal_request": {
      "type": "object",
      "required": [
        "base_revision",
        "reason",
        "operations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
